/**
 * 格式化日期显示
 * @param {string} dateStr - 格式如 "20251215"
 * @returns {string} - 格式如 "2025-12-15"
 */
function formatVipDate(dateStr) {
  if (!dateStr || dateStr === '00000000') {
    return '未开通'
  }
  
  var year = dateStr.substring(0, 4)
  var month = dateStr.substring(4, 6)
  var day = dateStr.substring(6, 8)
  
  return year + '-' + month + '-' + day
}

module.exports = {
  formatVipDate: formatVipDate
}

