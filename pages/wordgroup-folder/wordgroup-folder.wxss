/* pages/wordBookFolder/wordBookFolder.wxss */
.container {
  width: 100%;
  height: 100%;
  background:#FDFDFD;
}

scroll-view {
  width: 100%;
  height: 100%;
  background:#FDFDFD;
}

.field-container {
  box-sizing: border-box;
  width: 100%;
  margin: 28px 0 40px 0;
  padding: 0 24px;
}

/* 左滑操作按钮 */
.van-swipe-cell__right {
  display: flex !important;
  width: 130px !important;
}

.swipe-actions {
  display: flex;
  width: 100%;
  height: 100%;
}

.swipe-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 65px;
  height: 100%;
  color: #fff;
  font-size: 14px;
  flex-shrink: 0;
}

.swipe-action.export {
  background-color: #07c160;
}

.swipe-action.delete {
  background-color: #ee0a24;
}

@media (prefers-color-scheme: dark) {
  /* DarkMode 下的样式 start */
  .container {
    width: 100%;
    height: 100%;
    background:#1D1E30;
  }

  scroll-view {
    width: 100%;
    height: 100%;
    background:#1D1E30;
  }  
  /* DarkMode 下的样式 end */
}